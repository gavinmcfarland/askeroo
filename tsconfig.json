{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "outDir": "./dist",
        "isolatedModules": true,
        "noEmitOnError": true,
        "jsx": "react-jsx",
        "lib": ["ES2022"]
    },
    "include": ["src/**/*", "examples/**/*.ts", "examples/**/*.tsx"],
    "exclude": [
        "node_modules",
        "dist",
        "**/*.test.ts",
        "**/*.spec.ts",
        "archive/tests/**/*"
    ]
}
